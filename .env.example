# ─── Anthropic API ────────────────────────────────────────────
# https://console.anthropic.com/ でAPIキーを取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── microCMS ─────────────────────────────────────────────────
# サービスドメイン（URLの最初の部分）
MICROCMS_SERVICE_DOMAIN=9d1xfgkz89

# エンドポイント名
MICROCMS_ENDPOINT=blogs

# 書き込み用APIキー（POST権限が必要）
# 作成方法: microCMS管理画面 → 設定 → APIキー → 「コンテンツ」の
#           GET/POST/PUT/PATCH/DELETE すべてにチェックを入れて作成
MICROCMS_WRITE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Claude モデル（オプション） ──────────────────────────────
# 記事生成に使うモデル（変更しない場合はコメントアウトのまま）
# CLAUDE_MODEL=claude-opus-4-7
